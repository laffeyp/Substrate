erable', True):\n            raise NotSupportedError(\n                expression.__class__.__name__ + ' is disallowed in the filter '\n                'clause.'\n            )\n        if hasattr(expression, 'get_ancestors') and hasattr(expression, 'get_descendants'):\n            raise NotSupportedError(\n                expression.__class__.__name__ + ' is disallowed in the filter '\n                'clause.'\n            )\n        if isinstance(expression, Field) and expression.is_relation:\n            raise NotSupportedError(\n                expression.__class__.__name__ + ' is disallowed in the filter '\n                'clause.'\n            )\n        if hasattr(expression, 'filterable') and not isinstance(expression, Field):\n            # Check if the filterable attribute is a field, not just any attribute\n            if not isinstance(getattr(expression, 'filterable'), Field):\n                raise NotSupportedError(\n                    expression.__class__.__name__ + ' is disallowed in the filter '\n                    'clause.'\n                )\n>>>>>>> REPLACE","round":1,"slot":0},"trigger_id":"validate"},"producer":null,"schema":"substrate.TriggerFired@1","seq":15,"t":1786415558.139307}
