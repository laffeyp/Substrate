.\")})\n            else:\n                for key, value_ in hasher.safe_summary(value).items():\n                    summary.append({'label': gettext(key), 'value': value_})\n        context['summary'] = summary\n        return context\n\n    def id_for_label(self, id_):\n        return None\n>>>>>>> REPLACE","round":1,"slot":0},"producer":{"instance":"01KZT2VG2VGA7ANRCTGM8YT4NS","kind":"drafter","parent":"01KZT2VG2MSHV28Z1SKAZW3HCG"},"schema":"Candidate@1","seq":14,"t":1786508071.375998}
