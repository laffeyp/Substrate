r is not None:\n                data = data.loc[data[hue].isin(hue_order)]\n\n        colors = self._get_palette(data, hue, hue_order, palette)\n>>>>>>> REPLACE","round":1,"slot":0},"trigger_id":"validate"},"producer":null,"schema":"substrate.TriggerFired@1","seq":15,"t":1786432621.069761}
